# 复制为 deploy/env.primary。不要提交填写后的文件。
PRIMARY_LAN_IP=192.168.10.10
WORKER_HOST=192.168.10.11
WORKER_PORT=5000
PUBLIC_PORT=80
PRIMARY_WEB_PORT=5001
MYSQL_BUFFER_POOL_SIZE=1G

INSTANCE_ID=physics-web-1
DEPLOYMENT_ROLE=primary
RUN_DB_MIGRATIONS=true
REQUIRE_REDIS=true
TRUST_PROXY_HEADERS=true
SEB_INTEGRATION_ENABLED=true
SECRET_KEY=replace-with-the-same-long-random-value-on-both-nodes

MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_DATABASE=physics_new3
MYSQL_USER=physics_app
MYSQL_PASSWORD=replace-app-password
MYSQL_HOST=db
MYSQL_PORT=3306

REDIS_PASSWORD=replace-redis-password
REDIS_URL=redis://:replace-redis-password@redis:6379/0

PREWARM_ON_START=0
POOL_TARGET=260
POOL_LOW_WATER=120
POOL_REFILL_BATCH=50
POOL_PREWARM_PAUSE_SECONDS=0.1
WAITRESS_THREADS=32
WAITRESS_CONNECTION_LIMIT=4000
WAITRESS_CHANNEL_TIMEOUT=120
DB_POOL_SIZE=32
