# 复制为 deploy/env.worker。PRIMARY_LAN_IP填写主节点真实地址。
PRIMARY_LAN_IP=192.168.10.10
WORKER_LISTEN_PORT=5000

INSTANCE_ID=physics-web-2
DEPLOYMENT_ROLE=worker
RUN_DB_MIGRATIONS=false
REQUIRE_REDIS=true
TRUST_PROXY_HEADERS=true
SEB_INTEGRATION_ENABLED=true
SECRET_KEY=replace-with-the-same-long-random-value-on-both-nodes

MYSQL_DATABASE=physics_new3
MYSQL_USER=physics_app
MYSQL_PASSWORD=replace-app-password
MYSQL_HOST=192.168.10.10
MYSQL_PORT=3306

REDIS_PASSWORD=replace-redis-password
REDIS_URL=redis://:replace-redis-password@192.168.10.10:6379/0

PREWARM_ON_START=0
POOL_TARGET=260
POOL_LOW_WATER=120
POOL_REFILL_BATCH=50
POOL_PREWARM_PAUSE_SECONDS=0.1
WAITRESS_THREADS=32
WAITRESS_CONNECTION_LIMIT=4000
WAITRESS_CHANNEL_TIMEOUT=120
DB_POOL_SIZE=32
