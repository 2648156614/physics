# 搬迁到新服务器时：复制本文件为 .env，再填入真实值即可。
# cp .env.example .env && vi .env

# ---------- 必填 ----------
# 缺失会导致启动即报 RuntimeError；换值会让所有已登录用户 session 失效
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- Redis ----------
# docker-compose 内部走服务名，不要写 localhost
REDIS_URL=redis://redis:6379/0

# ---------- MySQL ----------
# 主机名为 docker-compose 中的服务名 db
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=root
# MYSQL_ROOT_PASSWORD 用于初始化 MySQL 容器，MYSQL_PASSWORD 用于 Web 应用连接数据库。
# 两者建议保持一致；已部署服务器不要随意修改，否则可能导致应用无法连接旧数据库。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=physics_new3

# ---------- 题目池预热 ----------
# 正确的变量名是 PREWARM_ON_START（不是 PREWARM）
# 1=启动时同步生成题目池，会阻塞启动数分钟；首次部署建议 0
PREWARM_ON_START=0
POOL_TARGET=260
POOL_LOW_WATER=120
POOL_REFILL_BATCH=50

# ---------- 并发 ----------
# WAITRESS_THREADS 不要超过 DB_POOL_SIZE 太多，否则高峰期取不到连接
WAITRESS_THREADS=32
WAITRESS_CONNECTION_LIMIT=4000
WAITRESS_CHANNEL_TIMEOUT=120
# mysql-connector 连接池硬上限为 32
DB_POOL_SIZE=32

# ---------- 可选 ----------
# 老库存在明文密码时，置 true 可在用户登录时自动升级为哈希
UPGRADE_LEGACY_PASSWORD_ON_LOGIN=false
